{{- if and (eq .chezmoi.os "windows") (lookPath "dotnet") -}}
{{- $shellPromptSrc := joinPath .chezmoi.sourceDir "private_dot_config/powershell/ShellPrompt" -}}
{{- range (glob (joinPath $shellPromptSrc "*.cs")) }}
# {{ . | base }} {{ include . | sha256sum }}
{{- end }}
{{- range (glob (joinPath $shellPromptSrc "*.csproj")) }}
# {{ . | base }} {{ include . | sha256sum }}
{{- end }}
{{- range (glob (joinPath $shellPromptSrc "*.psd1")) }}
# {{ . | base }} {{ include . | sha256sum }}
{{- end }}

$ErrorActionPreference = 'Stop'

$tmp = $null
$bak = $null
try {
    $dotnet = Get-Command dotnet -ErrorAction Stop | Select-Object -ExpandProperty Source
    $src = Join-Path '{{ .chezmoi.sourceDir }}' 'private_dot_config/powershell/ShellPrompt'
    $proj = Join-Path $src 'ShellPrompt.csproj'
    if (-not (Test-Path -LiteralPath $proj)) {
        throw "ShellPrompt project not found: $proj"
    }

    $out = Join-Path $HOME '.config/powershell/Modules/ShellPrompt'
    $parent = Split-Path $out -Parent
    $tmp = Join-Path ([System.IO.Path]::GetTempPath()) ("ShellPrompt-build-" + [guid]::NewGuid().ToString('N'))
    $bak = Join-Path ([System.IO.Path]::GetTempPath()) ("ShellPrompt-bak-" + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null

    & $dotnet publish $proj -c Release -o $tmp --nologo
    if ($LASTEXITCODE -ne 0) {
        throw "dotnet publish failed with exit code $LASTEXITCODE"
    }
    if (-not (Test-Path -LiteralPath (Join-Path $tmp 'ShellPrompt.dll'))) {
        throw 'dotnet publish succeeded but ShellPrompt.dll was not produced.'
    }

    New-Item -ItemType Directory -Force -Path $parent | Out-Null
    if (Test-Path -LiteralPath $out) {
        Move-Item -LiteralPath $out -Destination $bak -Force
    }
    try {
        Move-Item -LiteralPath $tmp -Destination $out
    }
    catch {
        if (Test-Path -LiteralPath $bak) {
            Move-Item -LiteralPath $bak -Destination $out -Force
        }
        throw
    }
    Write-Host "ShellPrompt published to $out"
}
catch {
    if ($tmp -and (Test-Path -LiteralPath $tmp)) {
        Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue
    }
    Write-Warning "ShellPrompt build failed: $_"
    Write-Warning 'Previous module kept if present. Re-run chezmoi apply after fixing the build, or use oh-my-posh when the DLL is missing.'
    exit 1
}
if ($bak -and (Test-Path -LiteralPath $bak)) {
    try {
        Remove-Item -LiteralPath $bak -Recurse -Force -ErrorAction Stop
    }
    catch {
        Write-Warning "ShellPrompt install succeeded, but removing the temporary backup of the previous module failed: $bak ($_)"
        exit 0
    }
}
{{- end -}}
