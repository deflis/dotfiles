{{- if and (eq .chezmoi.os "windows") (lookPath "dotnet") -}}
{{- range (glob "private_dot_config/powershell/ShellPrompt/*.{cs,csproj,psd1}") }}
# {{ . | base }} {{ include . | sha256sum }}
{{- end }}

$ErrorActionPreference = 'Stop'

$dotnet = Get-Command dotnet -ErrorAction Stop | Select-Object -ExpandProperty Source
$src = Join-Path '{{ .chezmoi.sourceDir }}' 'private_dot_config/powershell/ShellPrompt'
$proj = Join-Path $src 'ShellPrompt.csproj'
if (-not (Test-Path -LiteralPath $proj)) {
    throw "ShellPrompt project not found: $proj"
}

$out = Join-Path $HOME '.config/powershell/Modules/ShellPrompt'
$tmp = Join-Path ([System.IO.Path]::GetTempPath()) ("ShellPrompt-build-" + [guid]::NewGuid().ToString('N'))
New-Item -ItemType Directory -Force -Path $tmp | Out-Null

try {
    & $dotnet publish $proj -c Release -o $tmp --nologo
    if ($LASTEXITCODE -ne 0) {
        throw "dotnet publish failed with exit code $LASTEXITCODE"
    }
    if (-not (Test-Path -LiteralPath (Join-Path $tmp 'ShellPrompt.dll'))) {
        throw 'dotnet publish succeeded but ShellPrompt.dll was not produced.'
    }

    if (Test-Path -LiteralPath $out) {
        Remove-Item -LiteralPath $out -Recurse -Force
    }
    New-Item -ItemType Directory -Force -Path (Split-Path $out -Parent) | Out-Null
    Move-Item -LiteralPath $tmp -Destination $out
    Write-Host "ShellPrompt published to $out"
}
catch {
    if (Test-Path -LiteralPath $tmp) {
        Remove-Item -LiteralPath $tmp -Recurse -Force
    }
    Write-Warning "ShellPrompt build failed: $_"
    Write-Warning 'Keeping the previous module if present; otherwise the profile will use oh-my-posh.'
    exit 0
}
{{- end -}}
