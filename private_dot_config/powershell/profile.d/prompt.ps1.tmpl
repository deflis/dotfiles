{{- if and (eq .chezmoi.os "windows") (lookPath "dotnet") -}}
Import-Module (Join-Path $HOME '.config/powershell/Modules/ShellPrompt') -Force

$script:ShellPrompt_CmdStart = $null

Set-PSReadLineKeyHandler -Key Enter -ScriptBlock {
    $script:ShellPrompt_CmdStart = [System.Diagnostics.Stopwatch]::StartNew()
    [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()
}

function script:Get-ShellPromptIsRoot {
    $id = [Security.Principal.WindowsIdentity]::GetCurrent()
    return [Security.Principal.WindowsPrincipal]::new($id).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)
}

function prompt {
    $ok = $?
    $native = $LASTEXITCODE
    $exitCode = if ($ok) { 0 } elseif ($native) { $native } else { 1 }

    $executionMs = -1L
    if ($null -ne $script:ShellPrompt_CmdStart) {
        $executionMs = [long]$script:ShellPrompt_CmdStart.ElapsedMilliseconds
        $script:ShellPrompt_CmdStart = $null
    }

    $cwd = $PWD.ProviderPath
    $homeDir = $HOME
    $hostName = [System.Net.Dns]::GetHostName()
    $userName = $env:USERNAME
    $isSsh = [bool]($env:SSH_CONNECTION -or $env:SSH_CLIENT -or $env:SSH_TTY)
    $isRoot = Get-ShellPromptIsRoot
    $marker = if ($isRoot) { '#' } else { '$' }

    $titlePath = $cwd.Replace('\', '/')
    $homeNorm = $homeDir.Replace('\', '/')
    if ($titlePath.StartsWith($homeNorm, [System.StringComparison]::OrdinalIgnoreCase)) {
        $titlePath = '~' + $titlePath.Substring($homeNorm.Length)
    }

    $Host.UI.RawUI.WindowTitle = if ($isSsh) {
        "[${userName}@${hostName}] $titlePath $marker"
    } else {
        "$titlePath $marker"
    }

    Get-ShellPrompt `
        -ExitCode $exitCode `
        -ExecutionMs $executionMs `
        -Cwd $cwd `
        -ShellName 'pwsh' `
        -Columns ([Math]::Max(1, [Console]::WindowWidth)) `
        -HomeDir $homeDir `
        -HostName $hostName
}
{{- else if lookPath "oh-my-posh" -}}
{{ output "oh-my-posh" "init" "pwsh" "--config=~/.config/powershell/theme.yaml" }}
{{- end -}}
