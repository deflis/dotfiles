{{- if and (eq .chezmoi.os "windows") (lookPath "dotnet") -}}
$script:ShellPrompt_ModuleDir = Join-Path $HOME '.config/powershell/Modules/ShellPrompt'
$script:ShellPrompt_Dll = Join-Path $script:ShellPrompt_ModuleDir 'ShellPrompt.dll'

function script:Enable-OhMyPoshFallback {
{{- if lookPath "oh-my-posh" }}
    {{ output "oh-my-posh" "init" "pwsh" "--config=~/.config/powershell/theme.yaml" }}
{{- else }}
    Write-Warning 'ShellPrompt module is unavailable and oh-my-posh was not found.'
    function prompt {
        "PS $($executionContext.SessionState.Path.CurrentLocation)$('>' * ($nestedPromptLevel + 1)) "
    }
{{- end }}
}

if (-not (Test-Path -LiteralPath $script:ShellPrompt_Dll)) {
    Enable-OhMyPoshFallback
}
else {
    try {
        Import-Module $script:ShellPrompt_ModuleDir -ErrorAction Stop
    }
    catch {
        Write-Warning "ShellPrompt module failed to load: $_"
        Enable-OhMyPoshFallback
        return
    }

    if (-not (Get-Module -Name PSReadLine)) {
        return
    }

    $script:ShellPrompt_CmdStart = $null
    $script:ShellPrompt_StickyExit = 0
    $script:ShellPrompt_StickyExecMs = -1L
    $script:ShellPrompt_StickyNow = [DateTimeOffset]::Now
    $script:ShellPrompt_LastColumns = 0
    $script:ShellPrompt_HostName = [System.Net.Dns]::GetHostName()
    $script:ShellPrompt_UserName = $env:USERNAME
    $script:ShellPrompt_IsRoot = [Security.Principal.WindowsPrincipal]::new(
        [Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole(
        [Security.Principal.WindowsBuiltInRole]::Administrator)

    Set-PSReadLineKeyHandler -Key Enter -ScriptBlock {
        $script:ShellPrompt_CmdStart = [System.Diagnostics.Stopwatch]::StartNew()
        [Microsoft.PowerShell.PSConsoleReadLine]::AcceptLine()
    }

    function prompt {
        if ($null -ne $script:ShellPrompt_CmdStart) {
            $ok = $?
            $native = $LASTEXITCODE
            $script:ShellPrompt_StickyExit = if ($ok) { 0 } elseif ($native) { $native } else { 1 }
            $script:ShellPrompt_StickyExecMs = [long]$script:ShellPrompt_CmdStart.ElapsedMilliseconds
            $script:ShellPrompt_StickyNow = [DateTimeOffset]::Now
            $script:ShellPrompt_CmdStart = $null
        }

        $cwd = $PWD.ProviderPath
        $homeDir = $HOME
        $hostName = $script:ShellPrompt_HostName
        $userName = $script:ShellPrompt_UserName
        $isSsh = [bool]($env:SSH_CONNECTION -or $env:SSH_CLIENT -or $env:SSH_TTY)
        $isRoot = $script:ShellPrompt_IsRoot
        $marker = if ($isRoot) { '#' } else { '$' }

        if ($env:TERM -ne 'dumb') {
            $titlePath = $cwd.Replace('\', '/')
            $homeNorm = $homeDir.Replace('\', '/')
            if ($homeNorm.Length -gt 0 -and $titlePath.StartsWith($homeNorm, [System.StringComparison]::OrdinalIgnoreCase)) {
                $rest = $titlePath.Substring($homeNorm.Length)
                if ($rest.Length -eq 0 -or $rest.StartsWith('/')) {
                    $titlePath = '~' + $rest
                }
            }

            $Host.UI.RawUI.WindowTitle = if ($isSsh) {
                "[${userName}@${hostName}] $titlePath $marker"
            } else {
                "$titlePath $marker"
            }
        }

        $columns = [Math]::Max(1, [Console]::WindowWidth)
        $script:ShellPrompt_LastColumns = $columns

        Get-ShellPrompt `
            -ExitCode $script:ShellPrompt_StickyExit `
            -ExecutionMs $script:ShellPrompt_StickyExecMs `
            -Cwd $cwd `
            -ShellName 'pwsh' `
            -Columns $columns `
            -HomeDir $homeDir `
            -HostName $hostName `
            -Now $script:ShellPrompt_StickyNow
    }

    $null = Register-EngineEvent -SourceIdentifier PowerShell.OnIdle -Action {
        [ShellPrompt.ShellPromptRuntime]::PumpRefresh()

        $cols = [Console]::WindowWidth
        if ($cols -gt 0 -and $cols -ne $script:ShellPrompt_LastColumns) {
            $script:ShellPrompt_LastColumns = $cols
            [Microsoft.PowerShell.PSConsoleReadLine]::InvokePrompt()
        }
    }
}
{{- else if lookPath "oh-my-posh" -}}
{{ output "oh-my-posh" "init" "pwsh" "--config=~/.config/powershell/theme.yaml" }}
{{- end -}}
